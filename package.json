{
  "name": "ai-news-intelligence-dashboard",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=packages/backend\" \"npm run dev --workspace=packages/frontend\"",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@ai-news/frontend",
    "build:backend": "npm run build --workspace=packages/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "refresh": "npm run refresh --workspace=packages/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
